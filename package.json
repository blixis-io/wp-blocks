{
  "name": "blixis-wp-blocks",
  "version": "0.0.0",
  "private": true,
  "description": "Blixis WP Blocks monorepo root. See README.md.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "husky",
    "setup": "pnpm install --frozen-lockfile",
    "lint": "eslint . --ignore-pattern \"tooling/fixtures/bad/**\"",
    "lint:fix": "eslint . --fix --ignore-pattern \"tooling/fixtures/bad/**\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "commitlint": "commitlint --from origin/main --to HEAD",
    "check:boundaries": "node tooling/check-boundaries.mjs",
    "test:tooling": "node --test \"tooling/**/*.test.mjs\"",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run check:boundaries && pnpm run test:tooling",
    "lint:php": "composer run lint",
    "stan": "composer run stan",
    "test:php": "composer run test",
    "check:php": "composer run check",
    "check:licenses": "node tooling/check-licenses.mjs",
    "wp:start": "node tooling/wp-env/wp-env.mjs start",
    "wp:stop": "node tooling/wp-env/wp-env.mjs down",
    "wp:reset": "node tooling/wp-env/wp-env.mjs reset",
    "wp:seed": "node tooling/wp-env/wp-env.mjs install",
    "wp:cli": "node tooling/wp-env/wp-env.mjs cli",
    "wp:logs": "node tooling/wp-env/wp-env.mjs logs",
    "wp:smoke": "node tooling/wp-env/wp-env.mjs smoke"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
