{
  "$comment": "Distributable packages (ADR 0009). 'tier' is free or paid: paid packages are built only with --include-paid, which the public CI never uses (ADR 0009: Plus/Pro source is not published from public PR builds). 'main' carries the version header; 'identity' is the WordPress header every main file must also contain.",
  "distributions": [
    {
      "slug": "blixis",
      "kind": "theme",
      "source": "wordpress/theme",
      "main": "style.css",
      "required": [
        "style.css",
        "index.php",
        "theme.json",
        "assets/css/tokens.css",
        "assets/css/theme.css",
        "design/default-tokens.json",
        "design/presets/ocean.json",
        "design/presets/forest.json",
        "design/presets/sunset.json",
        "design/presets/minimal.json"
      ],
      "tier": "free",
      "identity": "Theme Name"
    },
    {
      "slug": "blixis-builder",
      "kind": "plugin",
      "source": "wordpress/plugin",
      "main": "blixis-builder.php",
      "required": [
        "blixis-builder.php",
        "data/core-elements.json",
        "data/css-properties.json",
        "assets/editor/editor.js",
        "assets/editor/editor.css",
        "assets/editor/manifest.json",
        "assets/editor/NOTICE.txt",
        "assets/editor/editor.js.LEGAL.txt",
        "assets/editor/canvas.js",
        "assets/editor/richtext.js"
      ],
      "tier": "free",
      "identity": "Plugin Name",
      "contentAllowlist": {
        "templates": [
          "NOTICE.md",
          "fonts/collection.json",
          "fonts/dm-sans/DMSans-opsz-wght.ttf",
          "fonts/dm-sans/OFL.txt",
          "fonts/inter/Inter-opsz-wght.ttf",
          "fonts/inter/OFL.txt",
          "fonts/manrope/Manrope-wght.ttf",
          "fonts/manrope/OFL.txt",
          "fonts/outfit/OFL.txt",
          "fonts/outfit/Outfit-wght.ttf",
          "fonts/plus-jakarta-sans/OFL.txt",
          "fonts/plus-jakarta-sans/PlusJakartaSans-wght.ttf",
          "fonts/space-grotesk/OFL.txt",
          "fonts/space-grotesk/SpaceGrotesk-wght.ttf",
          "packs/business/assets/business/case.webp",
          "packs/business/assets/business/hero.webp",
          "packs/business/assets/business/logo.svg",
          "packs/business/assets/business/preview.webp",
          "packs/business/template.json",
          "packs/creative-agency/assets/creative-agency/hero.webp",
          "packs/creative-agency/assets/creative-agency/logo.svg",
          "packs/creative-agency/assets/creative-agency/preview.webp",
          "packs/creative-agency/assets/creative-agency/project-one.webp",
          "packs/creative-agency/assets/creative-agency/project-two.webp",
          "packs/creative-agency/template.json",
          "packs/modern-homes/assets/modern-homes/hero.webp",
          "packs/modern-homes/assets/modern-homes/interior.webp",
          "packs/modern-homes/assets/modern-homes/logo.svg",
          "packs/modern-homes/assets/modern-homes/preview.webp",
          "packs/modern-homes/template.json",
          "packs/online-store/assets/online-store/hero.webp",
          "packs/online-store/assets/online-store/logo.svg",
          "packs/online-store/assets/online-store/preview.webp",
          "packs/online-store/assets/online-store/product-1.webp",
          "packs/online-store/assets/online-store/product-2.webp",
          "packs/online-store/assets/online-store/product-3.webp",
          "packs/online-store/template.json",
          "schema/template.schema.json"
        ]
      }
    },
    {
      "slug": "blixis-plus",
      "kind": "plugin",
      "source": "wordpress/plus",
      "main": "blixis-plus.php",
      "required": ["blixis-plus.php"],
      "tier": "paid",
      "identity": "Plugin Name"
    },
    {
      "slug": "blixis-pro",
      "kind": "plugin",
      "source": "wordpress/pro",
      "main": "blixis-pro.php",
      "required": ["blixis-pro.php"],
      "tier": "paid",
      "identity": "Plugin Name"
    }
  ],
  "exclude": [
    "node_modules",
    ".git",
    ".github",
    ".DS_Store",
    "tests",
    "test",
    "fixtures",
    "coverage",
    "dist",
    "package.json",
    "pnpm-lock.yaml",
    "tsconfig.json",
    "tsconfig.*.json",
    "composer.json",
    "composer.lock",
    "phpcs.xml*",
    "phpstan.neon*",
    "phpunit.xml*",
    "*.map",
    "theme.src.css",
    "build-css.mjs",
    "build-tokens.mjs",
    "*.log",
    "*.test.*",
    "*.md.bak"
  ],
  "forbidden": [
    ".env",
    ".env.*",
    "*.pem",
    "*.key",
    "*.p12",
    "*.pfx",
    "*.jks",
    "*.kdbx",
    "id_rsa",
    "id_ed25519",
    "*.sqlite",
    "*.sql",
    ".npmrc",
    ".netrc",
    ".htpasswd",
    ".git-credentials",
    "auth.json",
    "credentials*",
    ".aws",
    "wp-config.php",
    "*.crt",
    "*.cer"
  ],
  "allowedExtensions": [
    "php",
    "css",
    "js",
    "mjs",
    "json",
    "svg",
    "png",
    "jpg",
    "jpeg",
    "gif",
    "webp",
    "avif",
    "ico",
    "woff",
    "woff2",
    "ttf",
    "otf",
    "eot",
    "txt",
    "md",
    "pot",
    "po",
    "mo",
    "html",
    "xml"
  ],
  "allowedNames": ["LICENSE", "NOTICE", "README", "readme.txt", "CHANGELOG"],
  "limits": {
    "maxFileBytes": 20971520,
    "maxTotalBytes": 104857600,
    "maxFiles": 10000
  }
}
