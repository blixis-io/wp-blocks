{
  "$comment": "Distributable packages (ADR 0009). 'tier' is free or paid: paid packages are built only with --include-paid, which the public CI never uses (ADR 0009: Plus/Pro source is not published from public PR builds). 'main' carries the version header; 'identity' is the WordPress header every main file must also contain.",
  "distributions": [
    {
      "slug": "blixis",
      "kind": "theme",
      "source": "wordpress/theme",
      "main": "style.css",
      "required": ["style.css", "index.php"],
      "tier": "free",
      "identity": "Theme Name"
    },
    {
      "slug": "blixis-builder",
      "kind": "plugin",
      "source": "wordpress/plugin",
      "main": "blixis-builder.php",
      "required": ["blixis-builder.php"],
      "tier": "free",
      "identity": "Plugin Name"
    },
    {
      "slug": "blixis-plus",
      "kind": "plugin",
      "source": "wordpress/plus",
      "main": "blixis-plus.php",
      "required": ["blixis-plus.php"],
      "tier": "paid",
      "identity": "Plugin Name"
    },
    {
      "slug": "blixis-pro",
      "kind": "plugin",
      "source": "wordpress/pro",
      "main": "blixis-pro.php",
      "required": ["blixis-pro.php"],
      "tier": "paid",
      "identity": "Plugin Name"
    }
  ],
  "exclude": [
    "node_modules",
    ".git",
    ".github",
    ".DS_Store",
    "tests",
    "test",
    "fixtures",
    "coverage",
    "dist",
    "package.json",
    "pnpm-lock.yaml",
    "tsconfig.json",
    "tsconfig.*.json",
    "composer.json",
    "composer.lock",
    "phpcs.xml*",
    "phpstan.neon*",
    "phpunit.xml*",
    "*.map",
    "*.log",
    "*.test.*",
    "*.md.bak"
  ],
  "forbidden": [
    ".env",
    ".env.*",
    "*.pem",
    "*.key",
    "*.p12",
    "*.pfx",
    "*.jks",
    "*.kdbx",
    "id_rsa",
    "id_ed25519",
    "*.sqlite",
    "*.sql",
    ".npmrc",
    ".netrc",
    ".htpasswd",
    ".git-credentials",
    "auth.json",
    "credentials*",
    ".aws",
    "wp-config.php",
    "*.crt",
    "*.cer"
  ],
  "allowedExtensions": [
    "php",
    "css",
    "js",
    "mjs",
    "json",
    "svg",
    "png",
    "jpg",
    "jpeg",
    "gif",
    "webp",
    "avif",
    "ico",
    "woff",
    "woff2",
    "ttf",
    "otf",
    "eot",
    "txt",
    "md",
    "pot",
    "po",
    "mo",
    "html",
    "xml"
  ],
  "allowedNames": ["LICENSE", "NOTICE", "README", "readme.txt", "CHANGELOG"],
  "limits": {
    "maxFileBytes": 20971520,
    "maxTotalBytes": 104857600,
    "maxFiles": 10000
  }
}
