        "variant": {
          "classification": "invariant",
          "default": "solid",
          "kind": "enum",
          "label": "Style",
          "values": [
            "solid",
            "outline",
            "link"
          ]
        }
      },
      "requiresApi": 1,
      "tier": "free",
      "title": "Button",
      "type": "blixis/button",
      "version": 1
    },
    {
