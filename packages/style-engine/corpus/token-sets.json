            "code": "duplicate-name",
            "path": "tokens[1].name"
          }
        ]
      }
    },
    {
      "id": "unknown-reference",
      "description": "a reference without a fallback needs its token",
      "input": {
        "schemaVersion": 1,
        "tokenVersion": 1,
        "tokens": [
          {
            "name": "a",
            "category": "color",
            "value": "var(--blx-nope)"
          }
