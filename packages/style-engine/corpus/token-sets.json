      },
      "expect": {
        "ok": false,
        "issues": [
          {
            "code": "unknown-reference",
            "path": "tokens[0].value"
          }
        ]
      }
    },
    {
      "id": "cycle",
      "description": "a cycle fails every token on it and every user of it",
      "input": {
        "schemaVersion": 1,
        "tokenVersion": 1,
        "tokens": [
          {
            "name": "a",
            "category": "color",
            "value": "var(--blx-b)"
          },
          {
            "name": "b",
            "category": "color",
            "value": "var(--blx-a)"
          },
          {
            "name": "user",
            "category": "color",
            "value": "var(--blx-a)"
          }
        ]
      },
      "expect": {
        "ok": false,
        "issues": [
          {
            "code": "reference-cycle",
            "path": "tokens[0].value"
          },
          {
            "code": "reference-cycle",
            "path": "tokens[1].value"
          },
          {
            "code": "reference-cycle",
            "path": "tokens[2].value"
          }
        ]
      }
    },
    {
      "id": "dark-only-cycle",
      "description": "a cycle that exists only in dark mode is found",
      "input": {
        "schemaVersion": 1,
        "tokenVersion": 1,
        "tokens": [
          {
            "name": "a",
            "category": "color",
            "value": "red",
            "dark": "var(--blx-b)"
          },
          {
            "name": "b",
            "category": "color",
            "value": "var(--blx-a)"
          }
        ]
      },
      "expect": {
        "ok": false,
        "issues": [
          {
            "code": "reference-cycle",
            "path": "tokens[0].dark"
          },
          {
            "code": "reference-cycle",
            "path": "tokens[1].value"
          }
        ]
      }
    },
    {
      "id": "category-mismatch",
      "description": "an alias must point at a token of its own category",
      "input": {
        "schemaVersion": 1,
        "tokenVersion": 1,
        "tokens": [
          {
            "name": "a",
            "category": "color",
            "value": "var(--blx-b)"
          },
          {
            "name": "b",
            "category": "spacing",
            "value": "1rem"
          }
        ]
      },
      "expect": {
        "ok": false,
        "issues": [
          {
            "code": "category-mismatch",
            "path": "tokens[0].value"
          },
          {
            "code": "invalid-resolved-value",
            "path": "tokens[0].value"
          }
        ]
      }
    },
