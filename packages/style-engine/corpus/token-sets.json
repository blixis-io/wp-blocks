    {
      "id": "bad-name",
      "description": "names are lower-case words",
      "input": {
        "schemaVersion": 1,
        "tokenVersion": 1,
        "tokens": [
          {
            "name": "Color",
            "category": "color",
            "value": "red"
          }
        ]
      },
      "expect": {
        "ok": false,
        "issues": [
          {
            "code": "schema",
            "path": "$.tokens.0.name"
          }
        ]
      }
    },
    {
      "id": "bad-version",
      "description": "only schema version 1 exists",
      "input": {
        "schemaVersion": 2,
        "tokenVersion": 1,
        "tokens": []
      },
      "expect": {
        "ok": false,
        "issues": [
          {
            "code": "schema",
            "path": "$.schemaVersion"
          }
        ]
      }
    },
    {
      "id": "bad-token-version",
      "description": "tokenVersion is a non-negative integer",
      "input": {
        "schemaVersion": 1,
        "tokenVersion": -1,
        "tokens": []
      },
      "expect": {
        "ok": false,
        "issues": [
          {
            "code": "schema",
            "path": "$.tokenVersion"
          }
        ]
      }
    },
    {
      "id": "reserved-key",
      "description": "reserved keys are refused anywhere",
      "input": {
        "schemaVersion": 1,
        "tokenVersion": 0,
        "tokens": [],
        "__proto__": {
          "x": 1
        }
      },
      "expect": {
        "ok": false,
        "issues": [
          {
            "code": "reserved-key",
            "path": "$.__proto__"
          }
        ]
      }
    },
    {
      "id": "unknown-field-kept",
      "description": "unknown fields are accepted and ignored",
      "input": {
        "schemaVersion": 1,
        "tokenVersion": 1,
        "tokens": [
          {
            "name": "a",
            "category": "color",
            "value": "red"
          }
        ],
        "future": {
          "x": 1
        }
      },
      "expect": {
        "ok": true,
        "light": {
          "a": "red"
        },
        "dark": {
          "a": "red"
        },
        "compile": [
          {
            "name": "--blx-a",
            "value": "red",
            "category": "color"
          }
        ]
      }
    },
    {
      "id": "sparse-dark",
      "description": "a dark value equal to the base value is redundant and is not emitted; a different one is",
      "input": {
        "schemaVersion": 1,
        "tokenVersion": 1,
        "tokens": [
          {
            "name": "line",
            "category": "color",
            "value": "#cccccc",
            "dark": "#cccccc"
          },
          {
            "name": "bg",
            "category": "color",
            "value": "#ffffff",
            "dark": "#111111"
          }
        ]
      },
      "expect": {
        "ok": true,
        "light": {
          "line": "#cccccc",
          "bg": "#ffffff"
        },
        "dark": {
          "line": "#cccccc",
          "bg": "#111111"
        },
        "compile": [
          {
            "name": "--blx-line",
            "value": "#cccccc",
            "category": "color"
          },
          {
            "name": "--blx-bg",
            "value": "#ffffff",
            "category": "color"
          },
          {
            "name": "--blx-bg",
            "value": "#111111",
            "mode": "dark",
            "category": "color"
          }
        ]
      }
    }
  ]
