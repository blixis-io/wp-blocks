{
  "cases": [
    {
      "id": "empty",
      "description": "an empty set is valid",
      "input": {
        "schemaVersion": 1,
        "tokenVersion": 1,
        "tokens": []
      },
      "expect": {
        "ok": true,
        "light": {},
        "dark": {},
        "compile": []
      }
    },
    {
      "id": "basic",
      "description": "base and dark values; the compiler gets base values and dark overrides",
      "input": {
        "schemaVersion": 1,
        "tokenVersion": 1,
        "tokens": [
          {
            "name": "color-primary",
            "category": "color",
            "value": "#1a56db",
            "dark": "#76a9fa"
          },
          {
            "name": "space-4",
            "category": "spacing",
            "value": "1rem"
          }
        ]
      },
      "expect": {
        "ok": true,
        "light": {
          "color-primary": "#1a56db",
          "space-4": "1rem"
        },
        "dark": {
          "color-primary": "#76a9fa",
          "space-4": "1rem"
        },
        "compile": [
          {
            "name": "--blx-color-primary",
            "value": "#1a56db",
            "category": "color"
          },
          {
            "name": "--blx-color-primary",
            "value": "#76a9fa",
            "mode": "dark",
            "category": "color"
          },
          {
            "name": "--blx-space-4",
            "value": "1rem",
            "category": "spacing"
          }
        ]
      }
    },
    {
      "id": "alias-chain-per-mode",
      "description": "an alias follows the dark value of its target in dark mode",
      "input": {
        "schemaVersion": 1,
        "tokenVersion": 1,
        "tokens": [
          {
            "name": "brand",
            "category": "color",
            "value": "#111111",
            "dark": "#eeeeee"
          },
          {
            "name": "text",
            "category": "color",
            "value": "var(--blx-brand)"
          },
          {
            "name": "link",
            "category": "color",
            "value": "var(--blx-text)"
          }
        ]
      },
      "expect": {
        "ok": true,
        "light": {
          "brand": "#111111",
          "text": "#111111",
          "link": "#111111"
        },
        "dark": {
          "brand": "#eeeeee",
          "text": "#eeeeee",
          "link": "#eeeeee"
        },
        "compile": [
          {
            "name": "--blx-brand",
            "value": "#111111",
            "category": "color"
          },
          {
            "name": "--blx-brand",
            "value": "#eeeeee",
            "mode": "dark",
            "category": "color"
          },
          {
            "name": "--blx-text",
            "value": "var(--blx-brand)",
            "category": "color"
          },
          {
            "name": "--blx-link",
            "value": "var(--blx-text)",
            "category": "color"
          }
        ]
      }
    },
    {
      "id": "composite",
      "description": "references inside a longer value are substituted",
      "input": {
        "schemaVersion": 1,
        "tokenVersion": 1,
        "tokens": [
          {
            "name": "gap",
            "category": "spacing",
            "value": "1rem"
          },
          {
            "name": "pad",
            "category": "spacing",
            "value": "clamp(var(--blx-gap), 2vw, calc(var(--blx-gap) * 2))"
          }
        ]
      },
      "expect": {
        "ok": true,
        "light": {
          "gap": "1rem",
          "pad": "clamp(1rem, 2vw, calc(1rem * 2))"
        },
        "dark": {
          "gap": "1rem",
          "pad": "clamp(1rem, 2vw, calc(1rem * 2))"
        },
        "compile": [
          {
            "name": "--blx-gap",
            "value": "1rem",
            "category": "spacing"
          },
          {
            "name": "--blx-pad",
            "value": "clamp(var(--blx-gap), 2vw, calc(var(--blx-gap) * 2))",
            "category": "spacing"
          }
        ]
      }
    },
    {
      "id": "fallback-used",
      "description": "a fallback is used only when the token does not exist",
      "input": {
        "schemaVersion": 1,
        "tokenVersion": 1,
        "tokens": [
          {
            "name": "a",
            "category": "color",
            "value": "var(--blx-missing, #fff)"
          }
        ]
      },
      "expect": {
        "ok": true,
        "light": {
          "a": "#fff"
        },
        "dark": {
          "a": "#fff"
        },
        "compile": [
          {
            "name": "--blx-a",
            "value": "var(--blx-missing, #fff)",
            "category": "color"
          }
        ]
      }
    },
    {
      "id": "fallback-ignored",
      "description": "an existing token wins over the fallback",
      "input": {
        "schemaVersion": 1,
        "tokenVersion": 1,
        "tokens": [
          {
            "name": "b",
            "category": "color",
            "value": "#000000"
          },
          {
            "name": "a",
            "category": "color",
            "value": "var(--blx-b, #fff)"
          }
        ]
      },
      "expect": {
        "ok": true,
        "light": {
          "b": "#000000",
          "a": "#000000"
        },
        "dark": {
          "b": "#000000",
          "a": "#000000"
        },
        "compile": [
          {
            "name": "--blx-b",
            "value": "#000000",
            "category": "color"
          },
          {
            "name": "--blx-a",
            "value": "var(--blx-b, #fff)",
            "category": "color"
          }
        ]
      }
    },
    {
      "id": "font-stack",
      "description": "quoted plain font names are allowed",
      "input": {
        "schemaVersion": 1,
        "tokenVersion": 1,
        "tokens": [
          {
            "name": "font-body",
            "category": "font-family",
            "value": "\"Source Sans 3\", system-ui, sans-serif"
          }
        ]
      },
      "expect": {
        "ok": true,
        "light": {
          "font-body": "\"Source Sans 3\", system-ui, sans-serif"
        },
        "dark": {
          "font-body": "\"Source Sans 3\", system-ui, sans-serif"
        },
        "compile": [
          {
            "name": "--blx-font-body",
            "value": "\"Source Sans 3\", system-ui, sans-serif",
            "category": "font-family"
          }
        ]
      }
    },
    {
      "id": "not-a-colour",
      "description": "a colour token must be a colour",
      "input": {
        "schemaVersion": 1,
        "tokenVersion": 1,
        "tokens": [
          {
            "name": "a",
            "category": "color",
            "value": "12px"
          }
        ]
      },
      "expect": {
        "ok": false,
        "issues": [
          {
            "code": "invalid-value",
            "path": "tokens[0].value"
          }
        ]
      }
    },
    {
      "id": "url-injection",
      "description": "url() is never allowed",
      "input": {
        "schemaVersion": 1,
        "tokenVersion": 1,
        "tokens": [
          {
            "name": "a",
            "category": "color",
            "value": "url(https://x.example/a.png)"
          }
        ]
      },
      "expect": {
        "ok": false,
        "issues": [
          {
            "code": "invalid-value",
            "path": "tokens[0].value"
          }
        ]
      }
    },
    {
      "id": "dark-invalid",
      "description": "a dark value is checked too",
      "input": {
        "schemaVersion": 1,
        "tokenVersion": 1,
        "tokens": [
          {
            "name": "a",
            "category": "color",
            "value": "red"
          },
          {
            "name": "b",
            "category": "color",
            "value": "red",
            "dark": "notacolor"
          }
        ]
      },
      "expect": {
        "ok": false,
        "issues": [
          {
            "code": "invalid-value",
            "path": "tokens[1].dark"
          }
        ]
      }
    },
    {
      "id": "quote-breakout",
      "description": "a quoted name cannot hold a statement",
      "input": {
        "schemaVersion": 1,
        "tokenVersion": 1,
        "tokens": [
          {
            "name": "a",
            "category": "font-family",
            "value": "\"a;b\""
          }
        ]
      },
      "expect": {
        "ok": false,
        "issues": [
          {
            "code": "invalid-value",
            "path": "tokens[0].value"
          }
        ]
      }
    },
    {
      "id": "negative-spacing",
      "description": "spacing cannot be negative",
      "input": {
        "schemaVersion": 1,
        "tokenVersion": 1,
        "tokens": [
          {
            "name": "a",
            "category": "spacing",
            "value": "-1rem"
          }
        ]
      },
      "expect": {
        "ok": false,
        "issues": [
          {
            "code": "invalid-value",
            "path": "tokens[0].value"
          }
        ]
      }
    },
    {
      "id": "duplicate",
