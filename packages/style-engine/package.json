{
  "name": "@blixis/wp-style-engine",
  "version": "0.0.0",
  "private": true,
  "description": "CSS validation and deterministic compiler per ADR 0005. Shared with PHP through fixtures.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "dependencies": {
    "@blixis/wp-core": "workspace:*",
    "@blixis/wp-design-tokens": "workspace:*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./manifest/css-properties.json": "./manifest/css-properties.json",
    "./testing": "./src/cascade.test-helper.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "manifest:generate": "node scripts/generate-manifest.ts",
    "manifest:check": "node scripts/generate-manifest.ts --check"
  }
}
