{
  "$schema": "../../schemas/element-definition.schema.json",
  "definitionVersion": "1.0.0",
  "id": "show-more",
  "namespace": "blixis",
  "title": "Show More",
  "category": "advanced-motion",
  "description": "Show More element for Blixis WordPress visual builder. The record defines editor options and rendering contracts, not implementation code.",
  "icon": {
    "provider": "iconify",
    "set": "solar",
    "name": "alt-arrow-down-linear",
    "id": "solar:alt-arrow-down-linear",
    "validateAgainstInstalledSet": true
  },
  "subscription": {
    "minimumTier": "free",
    "availableIn": [
      "free",
      "plus",
      "pro"
    ],
    "upgradeFeature": null,
    "requiresServerEntitlement": false,
    "onDowngrade": "fully-available"
  },
  "origin": {
    "shadcnUiInspired": false,
    "interiorDevInspired": true,
    "referenceUrls": [
      "https://www.interior.dev/docs"
    ],
    "note": "Conceptual inspiration only; no third-party source code bundled."
  },
  "rendering": {
    "strategy": "php-server-rendered",
    "rendererKey": "blixis/show-more",
    "semanticTag": "button",
    "clientHydration": "on-interaction",
    "assetPolicy": "manifest-references-only",
    "unsafeHtml": "never",
    "fallbackRenderer": "safe-static"
  },
  "structure": {
    "acceptsChildren": false,
    "allowedChildren": "none",
    "minChildren": 0,
    "maxChildren": null,
    "allowedParentTypes": [
      "section",
      "container",
      "div",
      "flex",
      "grid",
      "columns",
      "stack",
      "row",
      "card",
      "tabs",
      "accordion",
      "loop-item",
      "form",
      "template-part"
    ]
  },
  "properties": {
    "elementId": {
      "type": "string",
      "default": "",
      "description": "Unique stable instance ID, created by the builder.",
      "required": true,
      "editorOnly": true
    },
    "cssClasses": {
      "type": "array<string>",
      "default": [],
      "description": "Additional validated class names.",
      "required": false,
      "control": "class-picker"
    },
    "htmlId": {
      "type": "string",
      "default": "",
      "description": "Optional sanitized HTML id.",
      "required": false,
      "control": "text"
    },
    "ariaLabel": {
      "type": "string",
      "default": "",
      "description": "Accessible name when native visible text is insufficient.",
      "required": false,
      "localizable": true,
      "control": "text"
    },
    "hidden": {
      "type": "boolean",
      "default": false,
      "description": "Hide the element. Prefer responsive visibility where relevant.",
      "required": false,
      "control": "switch"
    },
    "label": {
      "type": "string",
      "default": "Button",
      "description": "Text content. Localizable per locale.",
      "required": false,
      "localizable": true,
      "control": "textarea"
    },
    "action": {
      "type": "enum",
      "default": "link",
      "description": "Choose a supported option.",
      "required": false,
      "options": [
        "link",
        "submit",
        "scroll-to",
        "open-dialog",
        "toggle",
        "custom-event"
      ],
      "control": "select"
    },
    "href": {
      "type": "url",
      "default": "",
      "description": "Validated URL (http/https or approved internal route).",
      "required": false,
      "control": "link-picker"
    },
    "variant": {
      "type": "enum",
      "default": "primary",
      "description": "Choose a supported option.",
      "required": false,
      "options": [
        "primary",
        "secondary",
        "outline",
        "ghost",
        "destructive",
        "link"
      ],
      "control": "select"
    },
    "size": {
      "type": "enum",
      "default": "md",
      "description": "Choose a supported option.",
      "required": false,
      "options": [
        "xs",
        "sm",
        "md",
        "lg",
        "icon"
      ],
      "control": "select"
    },
    "disabled": {
      "type": "boolean",
      "default": false,
      "description": "Toggle behaviour.",
      "required": false,
      "control": "switch"
    },
    "iconBefore": {
      "type": "iconify-ref",
      "default": null,
      "description": "Iconify solar icon identifier.",
      "required": false
    },
    "iconAfter": {
      "type": "iconify-ref",
      "default": null,
      "description": "Iconify solar icon identifier.",
      "required": false
    }
  },
  "propertyControls": {
    "elementId": {
      "control": "text",
      "group": "Attributes",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "cssClasses": {
      "control": "class-picker",
      "group": "Attributes",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "htmlId": {
      "control": "text",
      "group": "Attributes",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "ariaLabel": {
      "control": "text",
      "group": "Accessibility",
      "localizable": true,
      "supportsDynamicBinding": false
    },
    "hidden": {
      "control": "switch",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "label": {
      "control": "textarea",
      "group": "Content",
      "localizable": true,
      "supportsDynamicBinding": true
    },
    "action": {
      "control": "select",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "href": {
      "control": "link-picker",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": true
    },
    "variant": {
      "control": "select",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "size": {
      "control": "select",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "disabled": {
      "control": "switch",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "iconBefore": {
      "control": "json-editor",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "iconAfter": {
      "control": "json-editor",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    }
  },
  "style": {
    "allowed": {
      "backgroundColor": {
        "type": "color-or-token",
        "default": null
      },
      "color": {
        "type": "color-or-token",
        "default": null
      },
      "fontSize": {
        "type": "css-length",
        "units": [
          "px",
          "rem",
          "em",
          "clamp"
        ],
        "default": null
      },
      "fontWeight": {
        "type": "number",
        "min": 100,
        "max": 900,
        "step": 100,
        "default": null
      },
      "padding": {
        "type": "box-sides",
        "units": [
          "px",
          "%",
          "rem",
          "em"
        ],
        "sides": [
          "top",
          "right",
          "bottom",
          "left"
        ],
        "linkable": true,
        "default": null
      },
      "margin": {
        "type": "box-sides",
        "units": [
          "px",
          "%",
          "rem",
          "em",
          "auto"
        ],
        "sides": [
          "top",
          "right",
          "bottom",
          "left"
        ],
        "linkable": true,
        "default": null
      },
      "borderRadius": {
        "type": "box-corners",
        "corners": [
          "topLeft",
          "topRight",
          "bottomRight",
          "bottomLeft"
        ],
        "units": [
          "px",
          "%",
          "rem"
        ],
        "linkable": true,
        "default": null
      },
      "borderWidth": {
        "type": "box-sides",
        "units": [
          "px",
          "rem"
        ],
        "linkable": true,
        "default": null
      },
      "borderColor": {
        "type": "color-or-token",
        "default": null
      },
      "width": {
        "type": "css-length",
        "units": [
          "px",
          "%",
          "rem",
          "em",
          "vw",
          "svw",
          "auto",
          "min-content",
          "max-content",
          "fit-content",
          "clamp"
        ],
        "default": null
      },
      "transition": {
        "type": "transition-list",
        "default": null
      }
    },
    "defaultValues": {},
    "responsive": {
      "enabled": true,
      "breakpoints": [
        "base",
        "tablet",
        "mobile"
      ],
      "inheritance": "base -> breakpoint override"
    },
    "appearance": {
      "enabled": true,
      "modes": [
        "light",
        "dark"
      ],
      "defaultMode": "light",
      "combinedOverrides": true,
      "precedence": [
        "base",
        "breakpoint",
        "appearance",
        "appearance+breakpoint"
      ]
    },
    "states": [
      "default",
      "hover",
      "focus-visible",
      "active",
      "disabled"
    ],
    "customCss": {
      "enabled": false,
      "scoped": true,
      "sanitized": true
    }
  },
  "motion": {
    "allowed": true,
    "presets": [
      "none",
      "fade-in",
      "slide-in-left",
      "slide-in-right",
      "slide-in-up",
      "scale-in"
    ],
    "triggers": [
      "page-load",
      "viewport-enter",
      "hover",
      "click",
      "scroll-progress"
    ],
    "engine": "engine-neutral",
    "reducedMotionPolicy": "respect-prefers-reduced-motion",
    "premiumTimelineRequires": "pro",
    "gsap": "optional-adapter-subject-to-license-review"
  },
  "bindings": {
    "supported": true,
    "sources": [
      "static",
      "wordpress-post",
      "wordpress-site",
      "wordpress-user",
      "wp-meta",
      "query-result",
      "woocommerce"
    ],
    "requiredTierForExternalDynamicSources": "plus"
  },
  "localization": {
    "enabled": true,
    "translatableProperties": [
      "ariaLabel",
      "label"
    ],
    "sourceLocale": "en",
    "fallbackPolicy": "source-locale",
    "stableElementIds": true
  },
  "accessibility": {
    "keyboardAccessible": true,
    "requirements": [
      "semantic HTML",
      "accessible name where applicable",
      "focus visibility",
      "reduced-motion fallback",
      "RTL-safe layout",
      "WCAG 2.2 AA target"
    ],
    "userSuppliedContentEscaped": true
  },
  "interactions": {
    "events": [
      "click",
      "keyboard-activate"
    ],
    "actions": [
      "none",
      "navigate",
      "submit",
      "toggle",
      "open-overlay",
      "scroll-to",
      "emit-allowlisted-event"
    ],
    "noArbitraryJavaScript": true
  },
  "dependencies": {
    "wordpressPlugins": [],
    "npmPackages": [],
    "optionalServices": []
  },
  "security": {
    "escapeText": true,
    "sanitizeAttributes": true,
    "validateUrls": true,
    "capabilityCheckOnSave": true,
    "doNotExecuteTemplateCode": true
  },
  "testing": {
    "unit": [
      "schema-validation",
      "default-props",
      "style-resolution",
      "locale-fallback",
      "serialization-roundtrip"
    ],
    "integration": [
      "php-renderer",
      "rest-permissions",
      "asset-resolution"
    ],
    "e2e": [
      "insert-and-select",
      "edit-props",
      "responsive-preview",
      "light-dark-preview",
      "save-reload",
      "keyboard-navigation"
    ]
  },
  "exampleInstance": {
    "id": "example-show-more",
    "type": "show-more",
    "props": {
      "cssClasses": [],
      "htmlId": "",
      "ariaLabel": "",
      "hidden": false,
      "label": "Button",
      "action": "link",
      "href": "",
      "variant": "primary",
      "size": "md",
      "disabled": false,
      "iconBefore": null,
      "iconAfter": null
    },
    "styles": {
      "base": {},
      "tablet": {},
      "mobile": {},
      "dark": {},
      "darkMobile": {}
    },
    "children": []
  },
  "implementation": {
    "status": "proposed",
    "priority": "post-MVP",
    "notes": [
      "Do not infer that a UI-component preview requires shipping React on the public site.",
      "Any client-side behavior must use isolated, progressively enhanced assets."
    ]
  }
}
