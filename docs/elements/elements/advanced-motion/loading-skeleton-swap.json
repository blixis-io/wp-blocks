{
  "$schema": "../../schemas/element-definition.schema.json",
  "definitionVersion": "1.0.0",
  "id": "loading-skeleton-swap",
  "namespace": "blixis",
  "title": "Loading Skeleton Swap",
  "category": "advanced-motion",
  "description": "Loading Skeleton Swap element for Blixis WordPress visual builder. The record defines editor options and rendering contracts, not implementation code.",
  "icon": {
    "provider": "iconify",
    "set": "solar",
    "name": "refresh-linear",
    "id": "solar:refresh-linear",
    "validateAgainstInstalledSet": true
  },
  "subscription": {
    "minimumTier": "plus",
    "availableIn": [
      "plus",
      "pro"
    ],
    "upgradeFeature": "loading-skeleton-swap",
    "requiresServerEntitlement": true,
    "onDowngrade": "preserve-rendering-disable-premium-editing"
  },
  "origin": {
    "shadcnUiInspired": false,
    "interiorDevInspired": true,
    "referenceUrls": [
      "https://www.interior.dev/docs"
    ],
    "note": "Conceptual inspiration only; no third-party source code bundled."
  },
  "rendering": {
    "strategy": "php-server-rendered",
    "rendererKey": "blixis/loading-skeleton-swap",
    "semanticTag": "div",
    "clientHydration": "on-interaction",
    "assetPolicy": "manifest-references-only",
    "unsafeHtml": "never",
    "fallbackRenderer": "safe-static"
  },
  "structure": {
    "acceptsChildren": true,
    "allowedChildren": "any",
    "minChildren": 0,
    "maxChildren": null,
    "allowedParentTypes": [
      "section",
      "container",
      "div",
      "flex",
      "grid",
      "columns",
      "stack",
      "row",
      "card",
      "tabs",
      "accordion",
      "loop-item",
      "form",
      "template-part"
    ]
  },
  "properties": {
    "elementId": {
      "type": "string",
      "default": "",
      "description": "Unique stable instance ID, created by the builder.",
      "required": true,
      "editorOnly": true
    },
    "cssClasses": {
      "type": "array<string>",
      "default": [],
      "description": "Additional validated class names.",
      "required": false,
      "control": "class-picker"
    },
    "htmlId": {
      "type": "string",
      "default": "",
      "description": "Optional sanitized HTML id.",
      "required": false,
      "control": "text"
    },
    "ariaLabel": {
      "type": "string",
      "default": "",
      "description": "Accessible name when native visible text is insufficient.",
      "required": false,
      "localizable": true,
      "control": "text"
    },
    "hidden": {
      "type": "boolean",
      "default": false,
      "description": "Hide the element. Prefer responsive visibility where relevant.",
      "required": false,
      "control": "switch"
    },
    "effect": {
      "type": "enum",
      "default": "fade-in",
      "description": "Choose a supported option.",
      "required": false,
      "options": [
        "fade-in",
        "slide-in-left",
        "slide-in-right",
        "slide-in-up",
        "scale-in",
        "rotate-in",
        "reveal",
        "custom"
      ],
      "control": "select"
    },
    "trigger": {
      "type": "enum",
      "default": "viewport-enter",
      "description": "Choose a supported option.",
      "required": false,
      "options": [
        "page-load",
        "viewport-enter",
        "hover",
        "click",
        "scroll-progress",
        "manual"
      ],
      "control": "select"
    },
    "durationMs": {
      "type": "number",
      "default": 900,
      "description": "Numeric setting.",
      "required": false,
      "control": "number"
    },
    "delayMs": {
      "type": "number",
      "default": 0,
      "description": "Numeric setting.",
      "required": false,
      "control": "number"
    },
    "easing": {
      "type": "enum",
      "default": "ease-out",
      "description": "Choose a supported option.",
      "required": false,
      "options": [
        "linear",
        "ease",
        "ease-in",
        "ease-out",
        "ease-in-out",
        "power2.out",
        "power3.out"
      ],
      "control": "select"
    },
    "repeat": {
      "type": "number",
      "default": 0,
      "description": "Numeric setting.",
      "required": false,
      "control": "number"
    },
    "reducedMotion": {
      "type": "enum",
      "default": "final-state",
      "description": "Choose a supported option.",
      "required": false,
      "options": [
        "final-state",
        "fade-only",
        "disable"
      ],
      "control": "select"
    },
    "from": {
      "type": "object",
      "default": {
        "opacity": 0,
        "x": -60,
        "y": 0,
        "scale": 1
      },
      "description": "Initial validated animation values.",
      "required": false
    },
    "to": {
      "type": "object",
      "default": {
        "opacity": 1,
        "x": 0,
        "y": 0,
        "scale": 1
      },
      "description": "Final animation state.",
      "required": false
    },
    "timelineRef": {
      "type": "timeline-ref",
      "default": null,
      "description": "Reusable animation timeline ID, if applicable.",
      "required": false
    },
    "start": {
      "type": "string",
      "default": "top bottom",
      "description": "Scroll start anchor or timeline offset (validated).",
      "required": false
    },
    "end": {
      "type": "string",
      "default": "bottom top",
      "description": "Scroll end anchor or duration (validated).",
      "required": false
    }
  },
  "propertyControls": {
    "elementId": {
      "control": "text",
      "group": "Attributes",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "cssClasses": {
      "control": "class-picker",
      "group": "Attributes",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "htmlId": {
      "control": "text",
      "group": "Attributes",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "ariaLabel": {
      "control": "text",
      "group": "Accessibility",
      "localizable": true,
      "supportsDynamicBinding": false
    },
    "hidden": {
      "control": "switch",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "effect": {
      "control": "select",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "trigger": {
      "control": "select",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "durationMs": {
      "control": "number",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "delayMs": {
      "control": "number",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "easing": {
      "control": "select",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "repeat": {
      "control": "number",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "reducedMotion": {
      "control": "select",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "from": {
      "control": "json-editor",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "to": {
      "control": "json-editor",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "timelineRef": {
      "control": "json-editor",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "start": {
      "control": "text",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "end": {
      "control": "text",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    }
  },
  "style": {
    "allowed": {
      "transform": {
        "type": "css-transform-list",
        "default": null
      },
      "opacity": {
        "type": "number",
        "min": 0,
        "max": 1,
        "step": 0.01,
        "default": null
      },
      "transition": {
        "type": "transition-list",
        "default": null
      },
      "filter": {
        "type": "css-filter-list",
        "default": null
      },
      "backdropFilter": {
        "type": "css-filter-list",
        "default": null
      }
    },
    "defaultValues": {},
    "responsive": {
      "enabled": true,
      "breakpoints": [
        "base",
        "tablet",
        "mobile"
      ],
      "inheritance": "base -> breakpoint override"
    },
    "appearance": {
      "enabled": true,
      "modes": [
        "light",
        "dark"
      ],
      "defaultMode": "light",
      "combinedOverrides": true,
      "precedence": [
        "base",
        "breakpoint",
        "appearance",
        "appearance+breakpoint"
      ]
    },
    "states": [
      "default",
      "hover",
      "focus-visible"
    ],
    "customCss": {
      "enabled": true,
      "scoped": true,
      "sanitized": true
    }
  },
  "motion": {
    "allowed": true,
    "presets": [
      "none",
      "fade-in",
      "slide-in-left",
      "slide-in-right",
      "slide-in-up",
      "scale-in",
      "stagger",
      "reveal",
      "typewriter"
    ],
    "triggers": [
      "page-load",
      "viewport-enter",
      "hover",
      "click",
      "scroll-progress"
    ],
    "engine": "engine-neutral",
    "reducedMotionPolicy": "respect-prefers-reduced-motion",
    "premiumTimelineRequires": "pro",
    "gsap": "optional-adapter-subject-to-license-review"
  },
  "bindings": {
    "supported": false,
    "sources": [
      "static",
      "wordpress-post",
      "wordpress-site",
      "wordpress-user",
      "wp-meta",
      "query-result",
      "woocommerce"
    ],
    "requiredTierForExternalDynamicSources": "plus"
  },
  "localization": {
    "enabled": true,
    "translatableProperties": [
      "ariaLabel"
    ],
    "sourceLocale": "en",
    "fallbackPolicy": "source-locale",
    "stableElementIds": true
  },
  "accessibility": {
    "keyboardAccessible": true,
    "requirements": [
      "semantic HTML",
      "accessible name where applicable",
      "focus visibility",
      "reduced-motion fallback",
      "RTL-safe layout",
      "WCAG 2.2 AA target"
    ],
    "userSuppliedContentEscaped": true
  },
  "interactions": {
    "events": [
      "start",
      "progress",
      "complete",
      "reverse"
    ],
    "actions": [
      "none",
      "navigate",
      "submit",
      "toggle",
      "open-overlay",
      "scroll-to",
      "emit-allowlisted-event"
    ],
    "noArbitraryJavaScript": true
  },
  "dependencies": {
    "wordpressPlugins": [],
    "npmPackages": [],
    "optionalServices": []
  },
  "security": {
    "escapeText": true,
    "sanitizeAttributes": true,
    "validateUrls": true,
    "capabilityCheckOnSave": true,
    "doNotExecuteTemplateCode": true
  },
  "testing": {
    "unit": [
      "schema-validation",
      "default-props",
      "style-resolution",
      "locale-fallback",
      "serialization-roundtrip"
    ],
    "integration": [
      "php-renderer",
      "rest-permissions",
      "asset-resolution"
    ],
    "e2e": [
      "insert-and-select",
      "edit-props",
      "responsive-preview",
      "light-dark-preview",
      "save-reload",
      "keyboard-navigation"
    ]
  },
  "exampleInstance": {
    "id": "example-loading-skeleton-swap",
    "type": "loading-skeleton-swap",
    "props": {
      "cssClasses": [],
      "htmlId": "",
      "ariaLabel": "",
      "hidden": false,
      "effect": "fade-in",
      "trigger": "viewport-enter",
      "durationMs": 900,
      "delayMs": 0,
      "easing": "ease-out",
      "repeat": 0,
      "reducedMotion": "final-state",
      "from": {
        "opacity": 0,
        "x": -60,
        "y": 0,
        "scale": 1
      },
      "to": {
        "opacity": 1,
        "x": 0,
        "y": 0,
        "scale": 1
      },
      "timelineRef": null,
      "start": "top bottom",
      "end": "bottom top"
    },
    "styles": {
      "base": {},
      "tablet": {},
      "mobile": {},
      "dark": {},
      "darkMobile": {}
    },
    "children": []
  },
  "implementation": {
    "status": "proposed",
    "priority": "post-MVP",
    "notes": [
      "Do not infer that a UI-component preview requires shipping React on the public site.",
      "Any client-side behavior must use isolated, progressively enhanced assets."
    ]
  }
}
