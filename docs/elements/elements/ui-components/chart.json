{
  "$schema": "../../schemas/element-definition.schema.json",
  "definitionVersion": "1.0.0",
  "id": "chart",
  "namespace": "blixis",
  "title": "Chart",
  "category": "ui-components",
  "description": "Chart element for Blixis WordPress visual builder. The record defines editor options and rendering contracts, not implementation code.",
  "icon": {
    "provider": "iconify",
    "set": "solar",
    "name": "chart-2-linear",
    "id": "solar:chart-2-linear",
    "validateAgainstInstalledSet": true
  },
  "subscription": {
    "minimumTier": "plus",
    "availableIn": [
      "plus",
      "pro"
    ],
    "upgradeFeature": "chart",
    "requiresServerEntitlement": true,
    "onDowngrade": "preserve-rendering-disable-premium-editing"
  },
  "origin": {
    "shadcnUiInspired": true,
    "interiorDevInspired": false,
    "referenceUrls": [
      "https://ui.shadcn.com/docs/components"
    ],
    "note": "Conceptual inspiration only; no third-party source code bundled."
  },
  "rendering": {
    "strategy": "php-server-rendered",
    "rendererKey": "blixis/chart",
    "semanticTag": "div",
    "clientHydration": "on-interaction",
    "assetPolicy": "manifest-references-only",
    "unsafeHtml": "never",
    "fallbackRenderer": "safe-static"
  },
  "structure": {
    "acceptsChildren": false,
    "allowedChildren": "none",
    "minChildren": 0,
    "maxChildren": null,
    "allowedParentTypes": [
      "section",
      "container",
      "div",
      "flex",
      "grid",
      "columns",
      "stack",
      "row",
      "card",
      "tabs",
      "accordion",
      "loop-item",
      "form",
      "template-part"
    ]
  },
  "properties": {
    "elementId": {
      "type": "string",
      "default": "",
      "description": "Unique stable instance ID, created by the builder.",
      "required": true,
      "editorOnly": true
    },
    "cssClasses": {
      "type": "array<string>",
      "default": [],
      "description": "Additional validated class names.",
      "required": false,
      "control": "class-picker"
    },
    "htmlId": {
      "type": "string",
      "default": "",
      "description": "Optional sanitized HTML id.",
      "required": false,
      "control": "text"
    },
    "ariaLabel": {
      "type": "string",
      "default": "",
      "description": "Accessible name when native visible text is insufficient.",
      "required": false,
      "localizable": true,
      "control": "text"
    },
    "hidden": {
      "type": "boolean",
      "default": false,
      "description": "Hide the element. Prefer responsive visibility where relevant.",
      "required": false,
      "control": "switch"
    },
    "kind": {
      "type": "enum",
      "default": "bar",
      "description": "Choose a supported option.",
      "required": false,
      "options": [
        "bar",
        "line",
        "area",
        "pie",
        "donut",
        "scatter"
      ],
      "control": "select"
    },
    "dataSource": {
      "type": "enum",
      "default": "static",
      "description": "Choose a supported option.",
      "required": false,
      "options": [
        "static",
        "query-ref",
        "remote-allowlisted"
      ],
      "control": "select"
    },
    "data": {
      "type": "array<object>",
      "default": [
        {
          "name": "A",
          "value": 10
        },
        {
          "name": "B",
          "value": 20
        }
      ],
      "description": "Static chart data.",
      "required": false
    },
    "queryRef": {
      "type": "query-ref",
      "default": null,
      "description": "Approved server-side data source.",
      "required": false
    },
    "xKey": {
      "type": "string",
      "default": "name",
      "description": "Data key for X axis.",
      "required": false
    },
    "yKey": {
      "type": "string",
      "default": "value",
      "description": "Data key for Y axis.",
      "required": false
    },
    "ariaDescription": {
      "type": "string",
      "default": "Chart data",
      "description": "Text content. Localizable per locale.",
      "required": false,
      "localizable": true,
      "control": "textarea"
    }
  },
  "propertyControls": {
    "elementId": {
      "control": "text",
      "group": "Attributes",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "cssClasses": {
      "control": "class-picker",
      "group": "Attributes",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "htmlId": {
      "control": "text",
      "group": "Attributes",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "ariaLabel": {
      "control": "text",
      "group": "Accessibility",
      "localizable": true,
      "supportsDynamicBinding": false
    },
    "hidden": {
      "control": "switch",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "kind": {
      "control": "select",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "dataSource": {
      "control": "select",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "data": {
      "control": "repeater",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "queryRef": {
      "control": "json-editor",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "xKey": {
      "control": "text",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "yKey": {
      "control": "text",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "ariaDescription": {
      "control": "textarea",
      "group": "Content",
      "localizable": true,
      "supportsDynamicBinding": false
    }
  },
  "style": {
    "allowed": {
      "width": {
        "type": "css-length",
        "units": [
          "px",
          "%",
          "rem",
          "em",
          "vw",
          "svw",
          "auto",
          "min-content",
          "max-content",
          "fit-content",
          "clamp"
        ],
        "default": null
      },
      "height": {
        "type": "css-length",
        "units": [
          "px",
          "%",
          "rem",
          "vh",
          "dvh",
          "auto"
        ],
        "default": null
      },
      "color": {
        "type": "color-or-token",
        "default": null
      },
      "backgroundColor": {
        "type": "color-or-token",
        "default": null
      }
    },
    "defaultValues": {},
    "responsive": {
      "enabled": true,
      "breakpoints": [
        "base",
        "tablet",
        "mobile"
      ],
      "inheritance": "base -> breakpoint override"
    },
    "appearance": {
      "enabled": true,
      "modes": [
        "light",
        "dark"
      ],
      "defaultMode": "light",
      "combinedOverrides": true,
      "precedence": [
        "base",
        "breakpoint",
        "appearance",
        "appearance+breakpoint"
      ]
    },
    "states": [
      "default",
      "hover",
      "focus-visible"
    ],
    "customCss": {
      "enabled": true,
      "scoped": true,
      "sanitized": true
    }
  },
  "motion": {
    "allowed": true,
    "presets": [
      "none",
      "fade-in",
      "slide-in-left",
      "slide-in-right",
      "slide-in-up",
      "scale-in"
    ],
    "triggers": [
      "page-load",
      "viewport-enter",
      "hover",
      "click",
      "scroll-progress"
    ],
    "engine": "engine-neutral",
    "reducedMotionPolicy": "respect-prefers-reduced-motion",
    "premiumTimelineRequires": "pro",
    "gsap": "optional-adapter-subject-to-license-review"
  },
  "bindings": {
    "supported": true,
    "sources": [
      "static",
      "wordpress-post",
      "wordpress-site",
      "wordpress-user",
      "wp-meta",
      "query-result",
      "woocommerce"
    ],
    "requiredTierForExternalDynamicSources": "plus"
  },
  "localization": {
    "enabled": true,
    "translatableProperties": [
      "ariaLabel",
      "ariaDescription"
    ],
    "sourceLocale": "en",
    "fallbackPolicy": "source-locale",
    "stableElementIds": true
  },
  "accessibility": {
    "keyboardAccessible": true,
    "requirements": [
      "semantic HTML",
      "accessible name where applicable",
      "focus visibility",
      "reduced-motion fallback",
      "RTL-safe layout",
      "WCAG 2.2 AA target"
    ],
    "userSuppliedContentEscaped": true
  },
  "interactions": {
    "events": [
      "data-change"
    ],
    "actions": [
      "none",
      "navigate",
      "submit",
      "toggle",
      "open-overlay",
      "scroll-to",
      "emit-allowlisted-event"
    ],
    "noArbitraryJavaScript": true
  },
  "dependencies": {
    "wordpressPlugins": [],
    "npmPackages": [],
    "optionalServices": []
  },
  "security": {
    "escapeText": true,
    "sanitizeAttributes": true,
    "validateUrls": true,
    "capabilityCheckOnSave": true,
    "doNotExecuteTemplateCode": true
  },
  "testing": {
    "unit": [
      "schema-validation",
      "default-props",
      "style-resolution",
      "locale-fallback",
      "serialization-roundtrip"
    ],
    "integration": [
      "php-renderer",
      "rest-permissions",
      "asset-resolution"
    ],
    "e2e": [
      "insert-and-select",
      "edit-props",
      "responsive-preview",
      "light-dark-preview",
      "save-reload",
      "keyboard-navigation"
    ]
  },
  "exampleInstance": {
    "id": "example-chart",
    "type": "chart",
    "props": {
      "cssClasses": [],
      "htmlId": "",
      "ariaLabel": "",
      "hidden": false,
      "kind": "bar",
      "dataSource": "static",
      "data": [
        {
          "name": "A",
          "value": 10
        },
        {
          "name": "B",
          "value": 20
        }
      ],
      "queryRef": null,
      "xKey": "name",
      "yKey": "value",
      "ariaDescription": "Chart data"
    },
    "styles": {
      "base": {},
      "tablet": {},
      "mobile": {},
      "dark": {},
      "darkMobile": {}
    },
    "children": []
  },
  "implementation": {
    "status": "proposed",
    "priority": "post-MVP",
    "notes": [
      "Do not infer that a UI-component preview requires shipping React on the public site.",
      "Any client-side behavior must use isolated, progressively enhanced assets."
    ]
  }
}
