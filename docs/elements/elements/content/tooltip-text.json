{
  "$schema": "../../schemas/element-definition.schema.json",
  "definitionVersion": "1.0.0",
  "id": "tooltip-text",
  "namespace": "blixis",
  "title": "Tooltip Text",
  "category": "content",
  "description": "Tooltip Text element for Blixis WordPress visual builder. The record defines editor options and rendering contracts, not implementation code.",
  "icon": {
    "provider": "iconify",
    "set": "solar",
    "name": "info-circle-linear",
    "id": "solar:info-circle-linear",
    "validateAgainstInstalledSet": true
  },
  "subscription": {
    "minimumTier": "plus",
    "availableIn": [
      "plus",
      "pro"
    ],
    "upgradeFeature": "tooltip-text",
    "requiresServerEntitlement": true,
    "onDowngrade": "preserve-rendering-disable-premium-editing"
  },
  "origin": {
    "shadcnUiInspired": false,
    "interiorDevInspired": false,
    "referenceUrls": [],
    "note": "Conceptual inspiration only; no third-party source code bundled."
  },
  "rendering": {
    "strategy": "php-server-rendered",
    "rendererKey": "blixis/tooltip-text",
    "semanticTag": "p",
    "clientHydration": "on-interaction",
    "assetPolicy": "manifest-references-only",
    "unsafeHtml": "never",
    "fallbackRenderer": "safe-static"
  },
  "structure": {
    "acceptsChildren": false,
    "allowedChildren": "none",
    "minChildren": 0,
    "maxChildren": null,
    "allowedParentTypes": [
      "section",
      "container",
      "div",
      "flex",
      "grid",
      "columns",
      "stack",
      "row",
      "card",
      "tabs",
      "accordion",
      "loop-item",
      "form",
      "template-part"
    ]
  },
  "properties": {
    "elementId": {
      "type": "string",
      "default": "",
      "description": "Unique stable instance ID, created by the builder.",
      "required": true,
      "editorOnly": true
    },
    "cssClasses": {
      "type": "array<string>",
      "default": [],
      "description": "Additional validated class names.",
      "required": false,
      "control": "class-picker"
    },
    "htmlId": {
      "type": "string",
      "default": "",
      "description": "Optional sanitized HTML id.",
      "required": false,
      "control": "text"
    },
    "ariaLabel": {
      "type": "string",
      "default": "",
      "description": "Accessible name when native visible text is insufficient.",
      "required": false,
      "localizable": true,
      "control": "text"
    },
    "hidden": {
      "type": "boolean",
      "default": false,
      "description": "Hide the element. Prefer responsive visibility where relevant.",
      "required": false,
      "control": "switch"
    },
    "content": {
      "type": "string",
      "default": "Sample text",
      "description": "Text content. Localizable per locale.",
      "required": false,
      "localizable": true,
      "control": "textarea"
    },
    "tag": {
      "type": "enum",
      "default": "p",
      "description": "Choose a supported option.",
      "required": false,
      "options": [
        "p",
        "h1",
        "h2",
        "h3",
        "h4",
        "h5",
        "h6",
        "span",
        "strong",
        "small",
        "div"
      ],
      "control": "select"
    },
    "marks": {
      "type": "array<richtext-mark>",
      "default": [],
      "description": "Inline formatting ranges with stable segment IDs (not raw HTML).",
      "required": false,
      "control": "rich-text-toolbar",
      "localizable": true
    }
  },
  "propertyControls": {
    "elementId": {
      "control": "text",
      "group": "Attributes",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "cssClasses": {
      "control": "class-picker",
      "group": "Attributes",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "htmlId": {
      "control": "text",
      "group": "Attributes",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "ariaLabel": {
      "control": "text",
      "group": "Accessibility",
      "localizable": true,
      "supportsDynamicBinding": false
    },
    "hidden": {
      "control": "switch",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "content": {
      "control": "textarea",
      "group": "Content",
      "localizable": true,
      "supportsDynamicBinding": true
    },
    "tag": {
      "control": "select",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "marks": {
      "control": "rich-text-toolbar",
      "group": "Content",
      "localizable": true,
      "supportsDynamicBinding": false
    }
  },
  "style": {
    "allowed": {
      "fontFamily": {
        "type": "font-reference",
        "default": null
      },
      "fontSize": {
        "type": "css-length",
        "units": [
          "px",
          "rem",
          "em",
          "clamp"
        ],
        "default": null
      },
      "fontWeight": {
        "type": "number",
        "min": 100,
        "max": 900,
        "step": 100,
        "default": null
      },
      "lineHeight": {
        "type": "number-or-css-length",
        "default": null
      },
      "letterSpacing": {
        "type": "css-length",
        "units": [
          "px",
          "em",
          "rem"
        ],
        "default": null
      },
      "textAlign": {
        "type": "enum",
        "options": [
          "left",
          "center",
          "right",
          "start",
          "end",
          "justify"
        ],
        "default": null
      },
      "color": {
        "type": "color-or-token",
        "default": null
      },
      "margin": {
        "type": "box-sides",
        "units": [
          "px",
          "%",
          "rem",
          "em",
          "auto"
        ],
        "sides": [
          "top",
          "right",
          "bottom",
          "left"
        ],
        "linkable": true,
        "default": null
      },
      "padding": {
        "type": "box-sides",
        "units": [
          "px",
          "%",
          "rem",
          "em"
        ],
        "sides": [
          "top",
          "right",
          "bottom",
          "left"
        ],
        "linkable": true,
        "default": null
      },
      "backgroundColor": {
        "type": "color-or-token",
        "default": null
      }
    },
    "defaultValues": {},
    "responsive": {
      "enabled": true,
      "breakpoints": [
        "base",
        "tablet",
        "mobile"
      ],
      "inheritance": "base -> breakpoint override"
    },
    "appearance": {
      "enabled": true,
      "modes": [
        "light",
        "dark"
      ],
      "defaultMode": "light",
      "combinedOverrides": true,
      "precedence": [
        "base",
        "breakpoint",
        "appearance",
        "appearance+breakpoint"
      ]
    },
    "states": [
      "default",
      "hover",
      "focus-visible"
    ],
    "customCss": {
      "enabled": true,
      "scoped": true,
      "sanitized": true
    }
  },
  "motion": {
    "allowed": true,
    "presets": [
      "none",
      "fade-in",
      "slide-in-left",
      "slide-in-right",
      "slide-in-up",
      "scale-in"
    ],
    "triggers": [
      "page-load",
      "viewport-enter",
      "hover",
      "click",
      "scroll-progress"
    ],
    "engine": "engine-neutral",
    "reducedMotionPolicy": "respect-prefers-reduced-motion",
    "premiumTimelineRequires": "pro",
    "gsap": "optional-adapter-subject-to-license-review"
  },
  "bindings": {
    "supported": true,
    "sources": [
      "static",
      "wordpress-post",
      "wordpress-site",
      "wordpress-user",
      "wp-meta",
      "query-result",
      "woocommerce"
    ],
    "requiredTierForExternalDynamicSources": "plus"
  },
  "localization": {
    "enabled": true,
    "translatableProperties": [
      "ariaLabel",
      "content",
      "marks"
    ],
    "sourceLocale": "en",
    "fallbackPolicy": "source-locale",
    "stableElementIds": true,
    "richTextSegmentsPerLocale": true
  },
  "accessibility": {
    "keyboardAccessible": true,
    "requirements": [
      "semantic HTML",
      "accessible name where applicable",
      "focus visibility",
      "reduced-motion fallback",
      "RTL-safe layout",
      "WCAG 2.2 AA target"
    ],
    "userSuppliedContentEscaped": true
  },
  "interactions": {
    "events": [
      "contentEdit"
    ],
    "actions": [
      "none",
      "navigate",
      "submit",
      "toggle",
      "open-overlay",
      "scroll-to",
      "emit-allowlisted-event"
    ],
    "noArbitraryJavaScript": true
  },
  "dependencies": {
    "wordpressPlugins": [],
    "npmPackages": [],
    "optionalServices": []
  },
  "security": {
    "escapeText": true,
    "sanitizeAttributes": true,
    "validateUrls": true,
    "capabilityCheckOnSave": true,
    "doNotExecuteTemplateCode": true
  },
  "testing": {
    "unit": [
      "schema-validation",
      "default-props",
      "style-resolution",
      "locale-fallback",
      "serialization-roundtrip"
    ],
    "integration": [
      "php-renderer",
      "rest-permissions",
      "asset-resolution"
    ],
    "e2e": [
      "insert-and-select",
      "edit-props",
      "responsive-preview",
      "light-dark-preview",
      "save-reload",
      "keyboard-navigation"
    ]
  },
  "exampleInstance": {
    "id": "example-tooltip-text",
    "type": "tooltip-text",
    "props": {
      "cssClasses": [],
      "htmlId": "",
      "ariaLabel": "",
      "hidden": false,
      "content": "Sample text",
      "tag": "p",
      "marks": []
    },
    "styles": {
      "base": {},
      "tablet": {},
      "mobile": {},
      "dark": {},
      "darkMobile": {}
    },
    "children": []
  },
  "implementation": {
    "status": "proposed",
    "priority": "post-MVP",
    "notes": [
      "Do not infer that a UI-component preview requires shipping React on the public site.",
      "Any client-side behavior must use isolated, progressively enhanced assets."
    ]
  }
}
