{
  "$schema": "../../schemas/element-definition.schema.json",
  "definitionVersion": "1.0.0",
  "id": "contact-form",
  "namespace": "blixis",
  "title": "Contact Form",
  "category": "forms",
  "description": "Contact Form element for Blixis WordPress visual builder. The record defines editor options and rendering contracts, not implementation code.",
  "icon": {
    "provider": "iconify",
    "set": "solar",
    "name": "letter-opened-linear",
    "id": "solar:letter-opened-linear",
    "validateAgainstInstalledSet": true
  },
  "subscription": {
    "minimumTier": "free",
    "availableIn": [
      "free",
      "plus",
      "pro"
    ],
    "upgradeFeature": null,
    "requiresServerEntitlement": false,
    "onDowngrade": "fully-available"
  },
  "origin": {
    "shadcnUiInspired": false,
    "interiorDevInspired": false,
    "referenceUrls": [],
    "note": "Conceptual inspiration only; no third-party source code bundled."
  },
  "rendering": {
    "strategy": "php-server-rendered",
    "rendererKey": "blixis/contact-form",
    "semanticTag": "form",
    "clientHydration": "on-interaction",
    "assetPolicy": "manifest-references-only",
    "unsafeHtml": "never",
    "fallbackRenderer": "safe-static"
  },
  "structure": {
    "acceptsChildren": true,
    "allowedChildren": "form-control",
    "minChildren": 1,
    "maxChildren": null,
    "allowedParentTypes": [
      "section",
      "container",
      "div",
      "flex",
      "grid",
      "columns",
      "stack",
      "row",
      "card",
      "tabs",
      "accordion",
      "loop-item",
      "form",
      "template-part"
    ]
  },
  "properties": {
    "elementId": {
      "type": "string",
      "default": "",
      "description": "Unique stable instance ID, created by the builder.",
      "required": true,
      "editorOnly": true
    },
    "cssClasses": {
      "type": "array<string>",
      "default": [],
      "description": "Additional validated class names.",
      "required": false,
      "control": "class-picker"
    },
    "htmlId": {
      "type": "string",
      "default": "",
      "description": "Optional sanitized HTML id.",
      "required": false,
      "control": "text"
    },
    "ariaLabel": {
      "type": "string",
      "default": "",
      "description": "Accessible name when native visible text is insufficient.",
      "required": false,
      "localizable": true,
      "control": "text"
    },
    "hidden": {
      "type": "boolean",
      "default": false,
      "description": "Hide the element. Prefer responsive visibility where relevant.",
      "required": false,
      "control": "switch"
    },
    "formId": {
      "type": "string",
      "default": "contact",
      "description": "Stable form identifier.",
      "required": false
    },
    "method": {
      "type": "enum",
      "default": "POST",
      "description": "Choose a supported option.",
      "required": false,
      "options": [
        "POST"
      ],
      "control": "select"
    },
    "endpointRef": {
      "type": "action-ref",
      "default": null,
      "description": "Null uses the built-in site-admin-email handler, which stores no entries; other references require a registered provider.",
      "required": false
    },
    "successMessage": {
      "type": "string",
      "default": "Thanks!",
      "description": "Text content. Localizable per locale.",
      "required": false,
      "localizable": true,
      "control": "textarea"
    },
    "errorMessage": {
      "type": "string",
      "default": "Something went wrong.",
      "description": "Text content. Localizable per locale.",
      "required": false,
      "localizable": true,
      "control": "textarea"
    },
    "spamProtection": {
      "type": "enum",
      "default": "honeypot",
      "description": "Choose a supported option.",
      "required": false,
      "options": [
        "honeypot",
        "captcha",
        "none"
      ],
      "control": "select"
    },
    "rateLimitPerMinute": {
      "type": "number",
      "default": 5,
      "description": "Numeric setting.",
      "required": false,
      "control": "number"
    }
  },
  "propertyControls": {
    "elementId": {
      "control": "text",
      "group": "Attributes",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "cssClasses": {
      "control": "class-picker",
      "group": "Attributes",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "htmlId": {
      "control": "text",
      "group": "Attributes",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "ariaLabel": {
      "control": "text",
      "group": "Accessibility",
      "localizable": true,
      "supportsDynamicBinding": false
    },
    "hidden": {
      "control": "switch",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "formId": {
      "control": "text",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "method": {
      "control": "select",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "endpointRef": {
      "control": "json-editor",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "successMessage": {
      "control": "textarea",
      "group": "Content",
      "localizable": true,
      "supportsDynamicBinding": false
    },
    "errorMessage": {
      "control": "textarea",
      "group": "Content",
      "localizable": true,
      "supportsDynamicBinding": false
    },
    "spamProtection": {
      "control": "select",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    },
    "rateLimitPerMinute": {
      "control": "number",
      "group": "Content",
      "localizable": false,
      "supportsDynamicBinding": false
    }
  },
  "style": {
    "allowed": {
      "display": {
        "type": "enum",
        "options": [
          "block",
          "inline",
          "inline-block",
          "flex",
          "inline-flex",
          "grid",
          "inline-grid",
          "none"
        ],
        "default": null
      },
      "gap": {
        "type": "css-length",
        "units": [
          "px",
          "rem",
          "em",
          "%"
        ],
        "default": null
      },
      "padding": {
        "type": "box-sides",
        "units": [
          "px",
          "%",
          "rem",
          "em"
        ],
        "sides": [
          "top",
          "right",
          "bottom",
          "left"
        ],
        "linkable": true,
        "default": null
      },
      "margin": {
        "type": "box-sides",
        "units": [
          "px",
          "%",
          "rem",
          "em",
          "auto"
        ],
        "sides": [
          "top",
          "right",
          "bottom",
          "left"
        ],
        "linkable": true,
        "default": null
      },
      "backgroundColor": {
        "type": "color-or-token",
        "default": null
      }
    },
    "defaultValues": {},
    "responsive": {
      "enabled": true,
      "breakpoints": [
        "base",
        "tablet",
        "mobile"
      ],
      "inheritance": "base -> breakpoint override"
    },
    "appearance": {
      "enabled": true,
      "modes": [
        "light",
        "dark"
      ],
      "defaultMode": "light",
      "combinedOverrides": true,
      "precedence": [
        "base",
        "breakpoint",
        "appearance",
        "appearance+breakpoint"
      ]
    },
    "states": [
      "default",
      "hover",
      "focus-visible"
    ],
    "customCss": {
      "enabled": false,
      "scoped": true,
      "sanitized": true
    }
  },
  "motion": {
    "allowed": true,
    "presets": [
      "none",
      "fade-in",
      "slide-in-left",
      "slide-in-right",
      "slide-in-up",
      "scale-in"
    ],
    "triggers": [
      "page-load",
      "viewport-enter",
      "hover",
      "click",
      "scroll-progress"
    ],
    "engine": "engine-neutral",
    "reducedMotionPolicy": "respect-prefers-reduced-motion",
    "premiumTimelineRequires": "pro",
    "gsap": "optional-adapter-subject-to-license-review"
  },
  "bindings": {
    "supported": false,
    "sources": [
      "static",
      "wordpress-post",
      "wordpress-site",
      "wordpress-user",
      "wp-meta",
      "query-result",
      "woocommerce"
    ],
    "requiredTierForExternalDynamicSources": "plus"
  },
  "localization": {
    "enabled": true,
    "translatableProperties": [
      "ariaLabel",
      "successMessage",
      "errorMessage"
    ],
    "sourceLocale": "en",
    "fallbackPolicy": "source-locale",
    "stableElementIds": true
  },
  "accessibility": {
    "keyboardAccessible": true,
    "requirements": [
      "semantic HTML",
      "accessible name where applicable",
      "focus visibility",
      "reduced-motion fallback",
      "RTL-safe layout",
      "WCAG 2.2 AA target"
    ],
    "userSuppliedContentEscaped": true
  },
  "interactions": {
    "events": [
      "submit",
      "success",
      "error"
    ],
    "actions": [
      "none",
      "navigate",
      "submit",
      "toggle",
      "open-overlay",
      "scroll-to",
      "emit-allowlisted-event"
    ],
    "noArbitraryJavaScript": true
  },
  "dependencies": {
    "wordpressPlugins": [],
    "npmPackages": [],
    "optionalServices": [
      "blixis-form-endpoint"
    ]
  },
  "security": {
    "escapeText": true,
    "sanitizeAttributes": true,
    "validateUrls": true,
    "capabilityCheckOnSave": true,
    "doNotExecuteTemplateCode": true
  },
  "testing": {
    "unit": [
      "schema-validation",
      "default-props",
      "style-resolution",
      "locale-fallback",
      "serialization-roundtrip"
    ],
    "integration": [
      "php-renderer",
      "rest-permissions",
      "asset-resolution"
    ],
    "e2e": [
      "insert-and-select",
      "edit-props",
      "responsive-preview",
      "light-dark-preview",
      "save-reload",
      "keyboard-navigation"
    ]
  },
  "exampleInstance": {
    "id": "example-contact-form",
    "type": "contact-form",
    "props": {
      "cssClasses": [],
      "htmlId": "",
      "ariaLabel": "",
      "hidden": false,
      "formId": "contact",
      "method": "POST",
      "endpointRef": null,
      "successMessage": "Thanks!",
      "errorMessage": "Something went wrong.",
      "spamProtection": "honeypot",
      "rateLimitPerMinute": 5
    },
    "styles": {
      "base": {},
      "tablet": {},
      "mobile": {},
      "dark": {},
      "darkMobile": {}
    },
    "children": []
  },
  "implementation": {
    "status": "proposed",
    "priority": "post-MVP",
    "notes": [
      "Do not infer that a UI-component preview requires shipping React on the public site.",
      "Any client-side behavior must use isolated, progressively enhanced assets."
    ]
  }
}
