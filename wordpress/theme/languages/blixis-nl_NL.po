msgstr "Bladgroen en warme neutrale tinten."

msgid "Warm terracotta and amber."
msgstr "Warme terracotta- en ambertinten."

msgid "High-contrast monochrome essentials."
msgstr "Essentiële monochrome kleuren met hoog contrast."

